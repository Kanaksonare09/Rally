# Copy this file to .env and fill in real values. Never commit .env.
#
# ENVIRONMENT selects the profile: "development" (default, local work),
# "test" (used implicitly by the test suite via tests/conftest.py — you
# never need to set this yourself), or "production". Setting
# ENVIRONMENT=production makes every value in the "Required in production"
# groups below mandatory — the app refuses to start if any are missing
# (see app/core/config.py's _validate_production_config). Development and
# test are unaffected by that check.

# --- Application ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# Swagger/OpenAPI/ReDoc. Set to false to disable public API docs in a real
# production deployment.
ENABLE_DOCS=true

# --- Supabase project (Settings > API in the Supabase dashboard) --- [required in production]
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only — never expose this to the frontend or in an API response.
SUPABASE_SERVICE_ROLE_KEY=

# --- Database --- [required in production]
# Supabase Postgres connection string (Settings > Database > Connection string > URI).
# Use the "Session pooler" or direct connection string, e.g.:
# postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=
# Connection pool (see app/core/database.py) — defaults are fine for a
# small demo deployment; tune upward only if you actually see pool
# exhaustion under load.
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800

# --- Redis (live trip state, presence, pub/sub, rate limiting) --- [required in production]
REDIS_URL=
REDIS_CONNECT_TIMEOUT_SECONDS=5
REDIS_SOCKET_TIMEOUT_SECONDS=5
REDIS_RETRY_LIMIT=5
REDIS_RETRY_MAX_BACKOFF_SECONDS=30

# --- Auth --- [required in production]
# Supabase Auth JWT signing secret (Settings > API > JWT Settings > JWT Secret).
JWT_SECRET=

# --- Routing engine (wired in a later phase) ---
OSRM_URL=

# --- CORS ---
# Comma-separated list of allowed frontend origins. CORS_ALLOWED_ORIGINS
# is preferred; FRONTEND_URL is kept as a fallback if it's already set.
# Never use a wildcard in production — this backend sends credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# --- Rate limiting (Redis-backed — see app/core/rate_limit.py) ---
RATE_LIMIT_ENABLED=true
GENERAL_API_RATE_LIMIT_PER_MINUTE=100
AUTH_RATE_LIMIT_PER_MINUTE=10
JOIN_GROUP_RATE_LIMIT_PER_MINUTE=10
SOS_RATE_LIMIT_PER_MINUTE=5

# --- WebSocket hardening ---
WS_MAX_MESSAGE_BYTES=8192
WEBSOCKET_MESSAGES_PER_SECOND=10
WEBSOCKET_FLOOD_DISCONNECT_THRESHOLD=20
MAX_WS_CONNECTIONS_PER_USER=5
MAX_LOCATION_UPDATES_PER_SECOND=5

# --- Data retention (documented, not activated in this phase) ---
# LOCATION_RETENTION_DAYS=90

# --- Trip replay (app/analytics/replay.py) ---
REPLAY_MIN_INTERVAL_SECONDS=2
REPLAY_MAX_INTERVAL_SECONDS=300
REPLAY_DEFAULT_INTERVAL_SECONDS=10
REPLAY_MAX_FRAMES=2000

# --- Smart risk score (app/risk/service.py) ---
RISK_LOW_MAX=30
RISK_MEDIUM_MAX=60
RISK_HIGH_MAX=80
RISK_WEIGHT_ACTIVE_SOS=50
RISK_WEIGHT_CRITICAL_ALERT=30
RISK_WEIGHT_GROUP_SEPARATION=17
RISK_WEIGHT_ISOLATED_MEMBER=12
RISK_WEIGHT_FALLING_BEHIND=10
RISK_WEIGHT_ROUTE_DEVIATION=8
RISK_WEIGHT_UNEXPECTED_STOP=8
RISK_WEIGHT_SPEED_ANOMALY=8
RISK_WEIGHT_LOW_ACTIVE_RATIO=10
RISK_LOW_ACTIVE_RATIO_THRESHOLD=0.5

# --- Weather integration (app/weather/service.py) — fully optional; core
# tracking works with none of this set. "open-meteo" needs no key at all. ---
WEATHER_PROVIDER=open-meteo
# WEATHER_API_KEY=              # only needed if WEATHER_PROVIDER=openweathermap
WEATHER_CACHE_TTL_SECONDS=900
WEATHER_REQUEST_TIMEOUT_SECONDS=5

# --- Demo mode (app/demo/) --- NEVER set true in a production deployment
# (refused at startup together with ENVIRONMENT=production — see
# app/core/config.py). Only enable this locally/for a hackathon demo.
DEMO_MODE=false
DEMO_TICK_INTERVAL_SECONDS=2
