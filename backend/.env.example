# Copy this file to .env and fill in real values. Never commit .env.

# --- Application ---
ENVIRONMENT=development

# --- Supabase project (Settings > API in the Supabase dashboard) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only — never expose this to the frontend or in an API response.
SUPABASE_SERVICE_ROLE_KEY=

# --- Database ---
# Supabase Postgres connection string (Settings > Database > Connection string > URI).
# Use the "Session pooler" or direct connection string, e.g.:
# postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=

# --- Redis (live state + websockets) ---
REDIS_URL=redis://localhost:6379/0

# --- Auth ---
# Supabase Auth JWT signing secret (Settings > API > JWT Settings > JWT Secret).
JWT_SECRET=

# --- Routing engine (wired in a later phase) ---
OSRM_URL=

# --- CORS ---
# Comma-separated list of allowed frontend origins.
FRONTEND_URL=http://localhost:3000
